# Copy to .env and fill in. .env is never committed, printed or logged (CLAUDE.md, D13).

# The tradebot database only. This user has no rights on n8n's database (D3).
DATABASE_URL=postgresql://tradebot:CHANGEME@127.0.0.1:5432/tradebot

# A tradebot-only OpenAI project key, so this project's spend is isolated and visible
# on the dashboard (ARCHITECTURE.md Sect.6).
OPENAI_API_KEY=CHANGEME

# The edges of the system speak IST; everything stored is timezone-aware (D17).
TZ=Asia/Kolkata

LOG_LEVEL=INFO

# The User-Agent is NOT here. It lives in config/sources.yaml, because it is not a secret
# and the scraping rules put endpoints and headers in config. D25 requires one consistent
# string that is never rotated, which is easier to honour with a single place to look.

# Google Sheets mirror of raw_announcements, for browsing only (src/tradebot/sheets/).
# Never the source of the announcements themselves - Postgres is that; the Sheet can be
# thrown away and rebuilt with `python -m tradebot.sheets --rebuild`.
# GOOGLE_SERVICE_ACCOUNT_FILE is a path to a service-account key JSON kept OUTSIDE this
# repo. GOOGLE_SHEET_ID is the id from the target Sheet's URL.
GOOGLE_SERVICE_ACCOUNT_FILE=CHANGEME
GOOGLE_SHEET_ID=CHANGEME

# The 12-month backfill's own database, on the laptop only (ARCHITECTURE.md §5.1, 27 Sep
# 2026). Same server and role as DATABASE_URL, database tradebot_backfill, created once by
# the Postgres superuser: CREATE DATABASE tradebot_backfill OWNER tradebot;
BACKFILL_DATABASE_URL=postgresql://tradebot:CHANGEME@127.0.0.1:5432/tradebot_backfill

# --- VPS / Docker only (DEPLOY.md). Compose reads these for ${...} substitution. ---
# In a container, GOOGLE_SERVICE_ACCOUNT_FILE is /app/secrets/<file>.json and the host in
# DATABASE_URL is the Postgres container's name on the network below.
# The existing Postgres container's Docker network (Spike E, ops/preflight.sh).
TRADEBOT_DB_NETWORK=CHANGEME
# That server's major version, for the pg_dump client in the backup job.
TRADEBOT_PG_MAJOR=16
# Optional per-service limits; the defaults in docker-compose.yml apply when unset.
# TRADEBOT_ORDERS_MEM=512m
# TRADEBOT_ORDERS_CPUS=0.5

# Backups (D14): the rclone remote and folder, configured once with `rclone config`.
RCLONE_REMOTE=CHANGEME
