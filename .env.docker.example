# For docker-compose.local-db.yml: copy to .env.docker (gitignored) and fill in.
# Compose reads it twice: for ${...} substitution (--env-file .env.docker) and as the
# containers' environment (REG30_RADAR_ENV_FILE=.env.docker).
REG30_RADAR_ENV_FILE=.env.docker

# The local Postgres container's password. Any long random string; docker-compose.local-db.yml
# builds DATABASE_URL from it.
REG30_RADAR_LOCAL_DB_PASSWORD=CHANGEME

# The same variables as .env.example, for the app itself.
OPENAI_API_KEY=CHANGEME
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/CHANGEME.json
GOOGLE_SHEET_ID=CHANGEME
REG30_RADAR_PG_MAJOR=16
