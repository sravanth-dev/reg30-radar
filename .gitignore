# Secrets. Never committed (CLAUDE.md, D13). .env.example carries the shape instead.
.env
.env.*
!.env.example

# Google service-account key files must never land in the repo, wherever they are saved.
secrets/
*service-account*.json

# Virtualenv (Windows layout is .venv/Scripts, Linux is .venv/bin)
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Downloaded PDFs are deleted after text extraction (D8). Two exceptions stay in the repo
# permanently and are un-ignored below: the labelled test set, and the HMT regression
# fixture for the garbled-OCR gap (§5.5, WORKLOG 24 Sep 2026 night).
# Note: neither directory itself is ignored, because a negation cannot rescue a file that
# sits inside an ignored directory.
*.pdf
!tests/labelled/*.pdf
!tests/fixtures/scans/*.pdf

# Scratch space for spikes and any working copies of exchange bundles.
data/
spikes/out/

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
